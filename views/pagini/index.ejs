           usemap="#map-garaj">
      <map name="map-garaj">
        <area shape="rect" coords="100,70,540,145" href="#acasa" alt="Banner Apex Auto Shop - spre pagina principala" title="Pagina principala">
        <area shape="circle" coords="188,268,28" href="#categorie" alt="Roata stanga - spre categorie produse" title="Categorie produse">
        <area shape="circle" coords="452,268,28" href="#tabel-oferte" alt="Roata dreapta - spre oferte saptamanale" title="Oferte saptamanale">
        <area shape="rect" coords="88,150,552,255" href="#evenimente" alt="Zona de lucru - spre evenimente" title="Evenimente si lansari">
      </map>
    </section>
